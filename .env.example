# Banco local (SQLite via libSQL). Em produção, a integração Turso da Vercel
# cria TURSO_DATABASE_URL e TURSO_AUTH_TOKEN automaticamente (também aceitos aqui).
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

# Gere um segredo forte: openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"
